          <Properties>
            <Property name="text" type="java.lang.String" value="&lt;html&gt;&lt;body style=&apos;width: 210px; text-align: center; font-family: sans-serif; font-size: 10px;&apos;&gt;&lt;b&gt;&#x26a0; &#xa1;ALERTA OPERATIVA - CAPACIDAD INSUFFICIENTES!&lt;/b&gt;&lt;br&gt;&lt;br&gt;&quot;Las Rejillas B&#xe1;sicas (70%) no son suficientes para el nivel actual de s&#xf3;lidos/caudal. Riesgo de desbordamiento.&quot;&lt;/body&gt;&lt;/html&gt;"/>
